---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";

const {
  title = "Kivanta Studio",
  description = "Digital products, websites, and experiments."
} = Astro.props;
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <slot />
    </main>
  </body>
</html>
