---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Journal — Kivanta Studio"
  description="Notes on websites, digital products, clarity, and the thinking behind Kivanta Studio."
>

  <section class="journal-page">

    <div class="journal-shell">

      <!-- =====================================================
           JOURNAL HERO
           ===================================================== -->

      <header class="journal-hero">

        <p class="eyebrow">
          KIVANTA JOURNAL
        </p>

        <h1>
          <span>Thoughts</span>
          <span>behind</span>
          <span>the work.</span>
        </h1>

        <p class="journal-intro">
          Notes on websites, digital products, useful systems,
          and the decisions that make digital work clearer.
        </p>

      </header>


      <!-- =====================================================
           LATEST WRITING
           ===================================================== -->

      <section class="writing">

        <div class="writing-heading">

          <p class="eyebrow">
            LATEST WRITING
          </p>

          <p class="writing-note">
            Ideas, process, and practical observations.
          </p>

        </div>


        <div class="article-grid">

          <!-- ARTICLE 01 -->
          <article class="article-card">

            <div class="article-visual article-visual-light">

              <div class="visual-title">
                Less noise.<br />
                More clarity.
              </div>

              <svg
                class="mountains mountains-light"
                viewBox="0 0 800 260"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path
                  d="M0 238 L105 170 L180 214 L280 125
                     L365 205 L470 102 L560 195
                     L655 145 L800 225 L800 260
                     L0 260 Z"
                />

                <path
                  d="M0 248 L130 205 L215 230
                     L325 175 L420 225 L520 165
                     L625 220 L720 190 L800 220"
                />
              </svg>

            </div>


            <div class="article-meta">

              <span>STUDIO NOTES</span>

              <span>4 MIN READ</span>

            </div>


            <h2>
              What makes a business website easy to use?
            </h2>


            <p class="article-description">
              A practical look at what helps visitors understand
              your business, trust what they see, and take the next step.
            </p>


            <div class="article-footer">
              <span>ARTICLE COMING SOON</span>
            </div>

          </article>


          <!-- ARTICLE 02 -->
          <article class="article-card">

            <div class="article-visual article-visual-dark">

              <div class="visual-title">
                Clarity turns<br />
                evidence into<br />
                progress.
              </div>

              <svg
                class="mountains mountains-dark"
                viewBox="0 0 800 260"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path
                  d="M325 260 L520 50 L680 260 Z"
                />

                <path
                  d="M470 260 L610 108 L800 260 Z"
                />
              </svg>

            </div>


            <div class="article-meta">

              <span>PRODUCT THINKING</span>

              <span>5 MIN READ</span>

            </div>


            <h2>
              The thinking behind Kivanta Scout
            </h2>


            <p class="article-description">
              How a simple idea became a focused tool for understanding
              public evidence before making claims.
            </p>


            <div class="article-footer">
              <span>ARTICLE COMING SOON</span>
            </div>

          </article>

        </div>

      </section>


      <!-- =====================================================
           WHY WRITE
           ===================================================== -->

      <section class="journal-note">

        <div class="journal-note-heading">

          <p class="eyebrow">
            WHY WRITE?
          </p>

          <h2>
            Good work gets better when the thinking is visible.
          </h2>

        </div>


        <p class="journal-note-copy">
          The Journal is where we document what we learn while building:
          decisions that worked, things that did not, and practical ideas
          worth carrying into the next project.
        </p>

      </section>


      <!-- =====================================================
           FOOTER
           ===================================================== -->

      <footer class="journal-footer">

        <a class="journal-brand" href="/">
          Kivanta Studio
        </a>

        <a class="journal-back" href="/#work">
          Back to selected work
          <span aria-hidden="true">→</span>
        </a>

      </footer>

    </div>

  </section>

</BaseLayout>


<style>

  /* =========================================================
     PAGE
     ========================================================= */

  .journal-page {
    width: 100%;
    min-width: 0;

    background: var(--page-bg);
    color: var(--text-primary);
  }


  .journal-shell {
    width: 100%;
    max-width: 1304px;

    margin: 0 auto;

    padding:
      92px
      32px
      42px;

    min-width: 0;
  }



  /* =========================================================
     SHARED
     ========================================================= */

  .eyebrow {
    margin: 0;

    color: var(--accent);

    font-size: 0.68rem;
    font-weight: 700;

    line-height: 1.4;

    letter-spacing: 0.16em;
  }



  /* =========================================================
     HERO
     ========================================================= */

  .journal-hero {
    width: 100%;
    max-width: 860px;

    padding-bottom: 78px;

    min-width: 0;
  }


  .journal-hero > .eyebrow {
    margin-bottom: 18px;
  }


  .journal-hero h1 {
    width: 100%;
    max-width: 760px;

    margin: 0;

    color: var(--text-primary);

    font-size:
      clamp(4.5rem, 7.4vw, 7.4rem);

    font-weight: 520;

    line-height: 0.91;

    letter-spacing: -0.065em;
  }


  .journal-hero h1 span {
    display: block;
  }


  .journal-intro {
    width: 100%;
    max-width: 610px;

    margin:
      30px
      0
      0;

    color: var(--text-secondary);

    font-size: 1rem;

    line-height: 1.7;
  }



  /* =========================================================
     WRITING
     ========================================================= */

  .writing {
    width: 100%;

    padding:
      52px
      0
      96px;

    border-top:
      1px solid
      var(--line);

    min-width: 0;
  }


  .writing-heading {
    width: 100%;

    margin-bottom: 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 32px;

    min-width: 0;
  }


  .writing-note {
    margin: 0;

    color: var(--text-secondary);

    font-size: 0.82rem;

    line-height: 1.5;
  }



  /* =========================================================
     ARTICLE GRID
     ========================================================= */

  .article-grid {
    width: 100%;

    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 28px;

    min-width: 0;
  }


  .article-card {
    width: 100%;

    min-width: 0;
  }



  /* =========================================================
     ARTICLE VISUAL
     ========================================================= */

  .article-visual {
    position: relative;

    width: 100%;
    height: 360px;

    overflow: hidden;

    border:
      1px solid
      var(--line);

    border-radius: 26px;
  }


  .article-visual-light {
    background:
      linear-gradient(
        145deg,
        #edf3ff,
        #dbe7f8
      );
  }


  .article-visual-dark {
    background:
      radial-gradient(
        circle at 78% 15%,
        rgba(58, 112, 215, 0.30),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        #111b2b,
        #08111d
      );
  }


  .visual-title {
    position: relative;

    z-index: 2;

    padding:
      38px
      40px;

    font-size:
      clamp(2rem, 3.5vw, 3.3rem);

    font-weight: 500;

    line-height: 1.03;

    letter-spacing: -0.05em;
  }


  .article-visual-light .visual-title {
    color: #153261;
  }


  .article-visual-dark .visual-title {
    color: #edf3ff;
  }



  /* =========================================================
     MOUNTAINS
     ========================================================= */

  .mountains {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    width: 100%;
    height: 64%;
  }


  .mountains-light path:first-child {
    fill:
      rgba(84, 129, 193, 0.18);
  }


  .mountains-light path:last-child {
    fill: none;

    stroke:
      rgba(70, 111, 171, 0.24);

    stroke-width: 2;
  }


  .mountains-dark path:first-child {
    fill:
      rgba(56, 95, 151, 0.55);
  }


  .mountains-dark path:last-child {
    fill:
      rgba(30, 58, 96, 0.72);
  }



  /* =========================================================
     ARTICLE TEXT
     ========================================================= */

  .article-meta {
    width: 100%;

    margin-top: 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 16px;

    color: var(--text-secondary);

    font-size: 0.57rem;
    font-weight: 700;

    line-height: 1.4;

    letter-spacing: 0.11em;

    min-width: 0;
  }


  .article-card h2 {
    width: 100%;
    max-width: 570px;

    margin:
      14px
      0
      0;

    color: var(--text-primary);

    font-size: 1.45rem;
    font-weight: 570;

    line-height: 1.25;

    letter-spacing: -0.035em;
  }


  .article-description {
    width: 100%;
    max-width: 570px;

    margin:
      10px
      0
      0;

    color: var(--text-secondary);

    font-size: 0.88rem;

    line-height: 1.65;
  }


  .article-footer {
    width: 100%;

    margin-top: 20px;

    padding-top: 17px;

    color: var(--text-secondary);

    font-size: 0.56rem;
    font-weight: 700;

    letter-spacing: 0.11em;

    border-top:
      1px solid
      var(--line);
  }



  /* =========================================================
     WHY WRITE
     ========================================================= */

  .journal-note {
    width: 100%;

    padding:
      76px
      0;

    display: grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(0, 0.9fr);

    align-items: end;

    gap:
      clamp(48px, 8vw, 100px);

    border-top:
      1px solid
      var(--line);

    min-width: 0;
  }


  .journal-note-heading {
    min-width: 0;
  }


  .journal-note-heading > .eyebrow {
    margin-bottom: 16px;
  }


  .journal-note h2 {
    width: 100%;
    max-width: 700px;

    margin: 0;

    color: var(--text-primary);

    font-size:
      clamp(2.8rem, 5vw, 4.6rem);

    font-weight: 520;

    line-height: 0.96;

    letter-spacing: -0.055em;
  }


  .journal-note-copy {
    width: 100%;
    max-width: 430px;

    margin:
      0
      0
      4px;

    color: var(--text-secondary);

    font-size: 0.9rem;

    line-height: 1.7;
  }



  /* =========================================================
     FOOTER
     ========================================================= */

  .journal-footer {
    width: 100%;

    padding-top: 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    border-top:
      1px solid
      var(--line);

    min-width: 0;
  }


  .journal-footer a {
    color: var(--text-secondary);

    font-size: 0.8rem;

    text-decoration: none;
  }


  .journal-brand {
    color:
      var(--text-primary) !important;

    font-weight: 650;
  }


  .journal-back {
    display: inline-flex;
    align-items: center;

    gap: 9px;
  }


  .journal-footer a:hover {
    color: var(--accent);
  }



  /* =========================================================
     DARK MODE
     ========================================================= */

  :global(html[data-theme="dark"]) .article-visual-light {
    background:
      linear-gradient(
        145deg,
        #dce6f7,
        #bdcce5
      );
  }



  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 900px) {

    .journal-shell {
      max-width: 760px;

      padding:
        78px
        20px
        36px;
    }


    .journal-hero {
      padding-bottom: 62px;
    }


    .journal-hero h1 {
      max-width: 620px;

      font-size:
        clamp(4rem, 10vw, 6rem);
    }


    .article-grid {
      grid-template-columns: 1fr;

      gap: 60px;
    }


    .journal-note {
      grid-template-columns: 1fr;

      gap: 30px;
    }


    .journal-note-copy {
      max-width: 560px;
    }

  }



  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 600px) {

    .journal-shell {
      width: 100%;
      max-width: none;

      padding:
        56px
        16px
        28px;
    }


    /* HERO */

    .journal-hero {
      max-width: none;

      padding-bottom: 50px;
    }


    .journal-hero > .eyebrow {
      margin-bottom: 16px;
    }


    .eyebrow {
      font-size: 0.63rem;

      letter-spacing: 0.14em;
    }


    .journal-hero h1 {
      width: 100%;
      max-width: none;

      font-size:
        clamp(2.8rem, 12vw, 3.35rem);

      line-height: 0.95;

      letter-spacing: -0.055em;
    }


    .journal-intro {
      width: 100%;
      max-width: none;

      margin-top: 24px;

      font-size: 0.92rem;

      line-height: 1.65;
    }



    /* WRITING */

    .writing {
      padding:
        42px
        0
        70px;
    }


    .writing-heading {
      margin-bottom: 24px;

      align-items: flex-start;
      flex-direction: column;

      gap: 8px;
    }


    .writing-note {
      font-size: 0.78rem;
    }


    .article-grid {
      grid-template-columns: minmax(0, 1fr);

      gap: 52px;
    }



    /* VISUALS */

    .article-visual {
      height: 230px;

      border-radius: 20px;
    }


    .visual-title {
      padding:
        24px
        22px;

      font-size:
        clamp(1.7rem, 7.8vw, 2rem);

      line-height: 1.04;
    }



    /* ARTICLE COPY */

    .article-meta {
      margin-top: 15px;

      flex-wrap: wrap;

      gap:
        6px
        12px;

      font-size: 0.5rem;

      letter-spacing: 0.09em;
    }


    .article-card h2 {
      max-width: none;

      margin-top: 11px;

      font-size: 1.18rem;

      line-height: 1.3;
    }


    .article-description {
      max-width: none;

      margin-top: 8px;

      font-size: 0.81rem;

      line-height: 1.6;
    }


    .article-footer {
      margin-top: 17px;

      padding-top: 14px;

      font-size: 0.5rem;
    }



    /* WHY WRITE */

    .journal-note {
      padding:
        58px
        0;

      grid-template-columns: minmax(0, 1fr);

      gap: 26px;
    }


    .journal-note h2 {
      max-width: none;

      font-size:
        clamp(2.2rem, 10vw, 2.8rem);

      line-height: 0.98;

      letter-spacing: -0.05em;
    }


    .journal-note-copy {
      max-width: none;

      margin: 0;

      font-size: 0.83rem;

      line-height: 1.65;
    }



    /* FOOTER */

    .journal-footer {
      align-items: flex-start;
      flex-direction: column;

      gap: 12px;
    }

  }



  /* =========================================================
     320PX STRESS SUPPORT
     ========================================================= */

  @media (max-width: 360px) {

    .journal-shell {
      padding-left: 13px;
      padding-right: 13px;
    }


    .journal-hero h1 {
      font-size:
        clamp(2.45rem, 12vw, 2.8rem);
    }


    .visual-title {
      font-size: 1.6rem;
    }


    .journal-note h2 {
      font-size:
        clamp(2rem, 10vw, 2.4rem);
    }

  }

</style>