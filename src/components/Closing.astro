---
const year = new Date().getFullYear();

const footerLinks = [
  { label: "Work", href: "/#work" },
  { label: "Services", href: "/#services" },
  { label: "About", href: "/#about" }
];

const socialLinks = [
  { label: "X", href: "https://x.com/KivantaStudio" },
  { label: "Instagram", href: "https://instagram.com/KivantaStudio" }
];
---

<section class="closing" id="contact">

  <div class="closing-inner">

    <div class="closing-copy">
      <p class="section-label">START A PROJECT</p>

      <h2>
        Have something<br />
        worth making real?
      </h2>

      <p>
        Include the type of business, what you need the website
        to do, and an approximate timeline.
      </p>
    </div>

    <a  class="closing-cta"
      href="mailto:hello@kivantastudio.com?subject=Project%20inquiry">
      <span>Start a project</span>
      <span aria-hidden="true">↗</span>
    </a>

  </div>

</section>


<footer class="footer">

  <div class="footer-inner">

    <div class="footer-brand">
      <a href="/">Kivanta Studio</a>

      <p>
        Independent digital studio.
      </p>
    </div>


    <div class="footer-nav">

      <div>
        <span class="footer-label">NAVIGATE</span>

        {
          footerLinks.map((link) => (
            <a href={link.href}>
              {link.label}
            </a>
          ))
        }
      </div>


      <div>
        <span class="footer-label">SOCIAL</span>

        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
            >
              {link.label}
            </a>
          ))
        }
      </div>

    </div>

  </div>


  <div class="footer-bottom">
    <span>© {year} Kivanta Studio</span>

    <span>Built for the web.</span>
  </div>

</footer>


<style>

  .closing {
    display: flex;
    align-items: center;

    padding: clamp(72px, 9vh, 120px) 0;

    background: #0a0a0a;
    color: #ffffff;
  }


  .closing-inner {
    width: min(1240px, calc(100% - 64px));
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 80px;
  }


  .section-label {
    margin: 0 0 18px;

    color: #9a9a9a;

    font-size: 0.66rem;
    font-weight: 650;

    letter-spacing: 0.15em;
  }


  h2 {
    margin: 0;

    font-size: clamp(3.5rem, 6vw, 6.4rem);
    font-weight: 520;

    line-height: 0.94;

    letter-spacing: -0.06em;
  }


  .closing-copy > p:last-child {
    max-width: 34em;

    margin: 22px 0 0;

    color: #c8c8c8;

    font-size: 1.0625rem;

    line-height: 1.6;
  }


  .closing-cta {
    width: 170px;
    height: 170px;

    flex: 0 0 auto;

    padding: 24px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;

    color: #111111;

    font-size: 1rem;
    font-weight: 600;

    text-decoration: none;

    border-radius: 50%;

    background: #f2f1ed;

    transition:
      transform 180ms ease,
      background 180ms ease;
  }


  .closing-cta:hover {
    transform: rotate(-4deg) scale(1.03);

    background: #ffffff;
  }


  .closing-cta span:last-child {
    align-self: flex-end;

    font-size: 1.3rem;
  }


  .footer {
    padding: 52px 0 26px;

    background: #0a0a0a;
    color: #ffffff;

    border-top: 1px solid rgba(255,255,255,0.08);
  }


  .footer-inner,
  .footer-bottom {
    width: min(1240px, calc(100% - 64px));
    margin: 0 auto;
  }


  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 80px;

    padding-bottom: 46px;
  }


  .footer-brand > a {
    color: #ffffff;

    font-size: 1.05rem;
    font-weight: 650;

    text-decoration: none;
  }


  .footer-brand p {
    margin: 10px 0 0;

    color: #9a9a9a;

    font-size: 0.8rem;
  }


  .footer-nav {
    display: flex;

    gap: 76px;
  }


  .footer-nav > div {
    min-width: 100px;

    display: flex;
    flex-direction: column;

    gap: 10px;
  }


  .footer-label {
    margin-bottom: 8px;

    color: #9a9a9a;

    font-size: 0.6rem;
    font-weight: 650;

    letter-spacing: 0.12em;
  }


  .footer-nav a {
    color: #989898;

    font-size: 0.83rem;

    text-decoration: none;
  }


  .footer-nav a:hover {
    color: #ffffff;
  }


  .footer-bottom {
    padding-top: 20px;

    display: flex;
    justify-content: space-between;

    color: #9a9a9a;

    font-size: 0.68rem;

    border-top: 1px solid rgba(255,255,255,0.07);
  }


  @media (max-width: 800px) {

    .closing-inner {
      flex-direction: column;
      align-items: flex-start;

      gap: 36px;
    }


    .closing-cta {
      width: 160px;
      height: 160px;
    }


    .footer-inner {
      flex-direction: column;

      gap: 48px;
    }

  }


  @media (max-width: 600px) {

    .closing-inner,
    .footer-inner,
    .footer-bottom {
      width: calc(100% - 32px);
    }


    h2 {
      font-size: clamp(3rem, 14vw, 4.5rem);
    }


    .footer-nav {
      width: 100%;

      justify-content: space-between;

      gap: 40px;
    }


    .footer-bottom {
      flex-direction: column;

      gap: 8px;
    }

  }

</style>


<style is:global>
  @media (min-width: 801px) {

    .closing-copy h2 {
      font-size: clamp(3.2rem, 5.2vw, 5.5rem);
    }

    .closing-cta {
      width: 150px;
      height: 150px;

      padding: 22px;
    }

  }

  :root[data-theme="dark"] .closing {
    background: #070b14;
    box-shadow: inset 0 1px 0 #8ea4c8;
  }

  :root[data-theme="dark"] .footer {
    background: #070b14;
    border-top-color: rgba(142, 164, 200, 0.28);
  }
</style>
