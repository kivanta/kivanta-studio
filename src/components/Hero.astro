---
const desktopPreview = "/images/work/towswift-desktop.png";
const mobilePreview = "/images/work/towswift-mobile.png";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        Independent web design studio
      </p>

      <h1 id="hero-title">
        Good businesses deserve a great website.
      </h1>

      <p class="hero-description">
        Thoughtful websites that help people understand your business,
        trust your work, and get in touch.
      </p>

      <div class="hero-actions">
        <a class="hero-primary" href="#contact">
          Discuss your project
          <span aria-hidden="true">↗</span>
        </a>

        <a class="hero-secondary" href="#work">
          Explore our work
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <p class="hero-note">
        Clear communication. Care in every detail.
      </p>
    </div>

    <figure class="hero-showcase">
      <div class="device-stage">
        <!-- Desktop screenshot retains its original proportions. -->
        <div class="desktop-device">
          <div class="desktop-screen">
            <img
              src={desktopPreview}
              alt="TowSwift concept website on desktop, showing its towing services and contact buttons."
              width="987"
              height="840"
              fetchpriority="high"
            />
          </div>

          <div class="desktop-stand" aria-hidden="true"></div>
          <div class="desktop-base" aria-hidden="true"></div>
        </div>

        <!-- Mobile screenshot retains its original proportions. -->
        <div class="phone-device">
          <div class="phone-screen">
            <img
              src={mobilePreview}
              alt="Mobile version of the TowSwift concept website."
              width="472"
              height="828"
            />
          </div>
        </div>
      </div>

      <figcaption>
        TowSwift <span aria-hidden="true">—</span> Concept project
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--page-bg);
    color: var(--text-primary);
  }

  .hero-inner {
    width: min(var(--container), calc(100% - 64px));
    margin: 0 auto;
    padding: 56px 0;

    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(32px, 4vw, 64px);
  }

  .hero-copy,
  .hero-showcase {
    min-width: 0;
  }

  .hero-eyebrow {
    margin: 0 0 18px;
    color: var(--text-secondary);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #hero-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .hero-description {
    max-width: 450px;
    margin: 20px 0 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
  }

  .hero-actions {
    margin-top: 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
  }

  .hero-primary,
  .hero-secondary {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;

    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  .hero-primary {
    padding: 13px 20px;
    color: var(--accent-text);
    background: var(--accent);
    border: 1px solid transparent;
    border-radius: 8px;
  }

  .hero-primary:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-secondary {
    color: var(--accent);
  }

  .hero-secondary:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-note {
    margin: 16px 0 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .hero-showcase {
    width: 100%;
    max-width: 500px;
    margin: 0;
    justify-self: center;
  }

  .device-stage {
    position: relative;
    padding: 16px 38px 24px 0;
  }

  .desktop-device {
    width: 100%;
  }

  .desktop-screen {
    overflow: hidden;
    background: #0b1015;
    border: 6px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgb(0 0 0 / 12%);
  }

  /* Auto height prevents cropping or stretching either screenshot. */
  .desktop-screen img,
  .phone-screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .desktop-stand {
    width: 20%;
    height: 30px;
    margin: 0 auto;
    background: var(--line);
    clip-path: polygon(22% 0, 78% 0, 100% 100%, 0 100%);
  }

  .desktop-base {
    width: 38%;
    height: 7px;
    margin: 0 auto;
    background: var(--line);
    border-radius: 50%;
  }

  .phone-device {
    position: absolute;
    right: 0;
    bottom: 21px;

    width: 29%;
    padding: 5px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 12px 28px rgb(0 0 0 / 20%);
  }

  .phone-screen {
    overflow: hidden;
    background: #0b1015;
    border-radius: 14px;
  }

  figcaption {
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
  }

  /* Desktop: navbar and hero share the opening viewport. */
  @media (min-width: 901px) {
    .hero {
      min-height: calc(100svh - 73px);
      display: flex;
      align-items: center;
    }

    .hero-inner {
      padding: clamp(20px, 4svh, 48px) 0;
    }

    .hero-showcase {
      max-width: min(500px, 65svh);
    }
  }

  /* Responsive foundations for our later tablet/mobile review. */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero-copy {
      max-width: 620px;
    }

    #hero-title {
      font-size: clamp(2.5rem, 6vw, 3.5rem);
    }
  }

  @media (max-width: 600px) {
    .hero-inner {
      width: calc(100% - 32px);
      padding: 42px 0 48px;
      gap: 28px;
    }

    .hero-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
    }

    #hero-title {
      font-size: clamp(2rem, 9vw, 3rem);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .device-stage {
      padding-right: 26px;
    }

    .phone-device {
      width: 32%;
      border-radius: 16px;
    }

    .phone-screen {
      border-radius: 11px;
    }
  }
</style>