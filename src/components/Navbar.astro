---
const navLinks = [
  { label: "Work", href: "/#work" },
  { label: "Services", href: "/#services" },
  { label: "About", href: "/#about" }
];
---

<header class="site-header">
  <nav class="navbar" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Kivanta Studio home">
      Kivanta Studio
    </a>

    <div class="nav-actions">
      <!-- Desktop navigation -->
      <div class="desktop-nav">
        <div class="nav-links">
          {
            navLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))
          }
        </div>

        <a class="nav-cta" href="/#contact">
          Discuss your project
        </a>
      </div>

      <!-- Theme switch: visible on desktop and mobile -->
      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch color theme"
        hidden
      >
        <!-- Sun: switch to light mode -->
        <svg
          class="theme-icon theme-icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
          />
        </svg>

        <!-- Moon: switch to dark mode -->
        <svg
          class="theme-icon theme-icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"
          />
        </svg>
      </button>

      <!-- Mobile navigation -->
      <details class="mobile-menu">
        <summary aria-label="Navigation menu">
          Menu
        </summary>

        <div class="mobile-panel">
          {
            navLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))
          }

          <a class="mobile-cta" href="/#contact">
            Discuss your project
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* Header */
  .site-header {
    width: 100%;
    background: var(--page-bg);
    border-bottom: 1px solid var(--line);
  }

  .navbar {
    width: min(var(--container), calc(100% - 64px));
    min-height: 72px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    color: var(--text-primary);
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Desktop links */
  .nav-actions,
  .desktop-nav,
  .nav-links {
    display: flex;
    align-items: center;
  }

  .nav-actions {
    gap: 14px;
  }

  .desktop-nav {
    gap: 28px;
  }

  .nav-links {
    gap: 24px;
  }

  .nav-links a {
    min-height: 44px;

    display: inline-flex;
    align-items: center;

    color: var(--text-secondary);
    font-size: 0.875rem;
    text-decoration: none;

    transition: color var(--transition-fast);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--text-primary);
  }

  /* Shared button appearance */
  .nav-cta,
  .theme-toggle {
    min-height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);

    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;

    transition: background var(--transition-fast);
  }

  .nav-cta {
    padding: 0 18px;
  }

  .nav-cta:hover,
  .theme-toggle:hover {
    background: var(--surface);
  }

  /* Sun and moon switch */
  .theme-toggle {
    width: 44px;
    min-width: 44px;
    height: 44px;
    padding: 0;
    flex-shrink: 0;
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-icon {
    width: 20px;
    height: 20px;
    pointer-events: none;
  }

  .theme-icon-sun {
    display: none;
  }

  .theme-icon-moon {
    display: block;
  }

  :global(html[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }

  :global(html[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    min-height: 44px;
    padding: 0 4px;

    display: flex;
    align-items: center;

    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;

    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    z-index: 100;
    top: calc(100% + 10px);
    right: 0;

    width: min(240px, calc(100vw - 32px));
    padding: 12px;

    display: flex;
    flex-direction: column;
    gap: 4px;

    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-small);
    box-shadow: var(--menu-shadow);
  }

  .mobile-menu:not([open]) .mobile-panel {
    display: none;
  }

  .mobile-panel a {
    min-height: 44px;
    padding: 10px;

    display: flex;
    align-items: center;

    color: var(--text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 8px;
  }

  .mobile-panel a:hover,
  .mobile-panel a:focus-visible {
    color: var(--text-primary);
    background: var(--surface);
  }

  .mobile-panel .mobile-cta {
    margin-top: 6px;
    justify-content: center;

    color: var(--text-primary);
    font-weight: 500;

    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }

  /* Tablet and phone navigation */
  @media (max-width: 820px) {
    .navbar {
      width: calc(100% - 32px);
      min-height: 64px;
      gap: 12px;
    }

    .nav-actions {
      gap: 10px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  /* Respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .nav-links a,
    .nav-cta,
    .theme-toggle {
      transition: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const themeButton =
    document.querySelector<HTMLButtonElement>(".theme-toggle");

  const systemTheme = window.matchMedia(
    "(prefers-color-scheme: dark)"
  );

  // Describe what pressing the icon will do.
  function updateThemeButton() {
    const isDark = root.dataset.theme === "dark";
    const label = isDark
      ? "Switch to light mode"
      : "Switch to dark mode";

    themeButton?.setAttribute("aria-label", label);
    themeButton?.setAttribute("title", label);
  }

  if (themeButton) {
    updateThemeButton();
    themeButton.hidden = false;

    themeButton.addEventListener("click", () => {
      const nextTheme =
        root.dataset.theme === "dark" ? "light" : "dark";

      root.dataset.theme = nextTheme;
      root.dataset.themePreference = nextTheme;

      try {
        localStorage.setItem("kivanta-theme", nextTheme);
      } catch {
        // Theme switching still works when storage is unavailable.
      }

      updateThemeButton();
    });
  }

  // Follow device appearance until a manual choice is made.
  systemTheme.addEventListener("change", (event) => {
    if (root.dataset.themePreference === "system") {
      root.dataset.theme = event.matches ? "dark" : "light";
      updateThemeButton();
    }
  });

  // Mobile menu interactions.
  const mobileMenu =
    document.querySelector<HTMLDetailsElement>(".mobile-menu");

  if (mobileMenu) {
    const summary = mobileMenu.querySelector("summary");

    // Close after selecting a link.
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.open = false;
      });
    });

    // Close when clicking elsewhere.
    document.addEventListener("click", (event) => {
      if (
        mobileMenu.open &&
        event.target instanceof Node &&
        !mobileMenu.contains(event.target)
      ) {
        mobileMenu.open = false;
      }
    });

    // Close with Escape and return keyboard focus.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileMenu.open) {
        mobileMenu.open = false;
        summary?.focus();
      }
    });

    // Close when switching to the desktop layout.
    const desktopViewport = window.matchMedia(
      "(min-width: 821px)"
    );

    desktopViewport.addEventListener("change", (event) => {
      if (event.matches) {
        mobileMenu.open = false;
      }
    });
  }
</script>